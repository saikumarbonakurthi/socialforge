# ============================================================
# SocialForge Backend — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Twitter / X ──────────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
# Required: Elevated Access, Read+Write permissions on your App
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── LinkedIn ──────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers/apps
# Scopes needed: w_member_social, r_liteprofile
# LINKEDIN_PERSON_URN: your LinkedIn URN — get via GET /v2/me
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ── Facebook (Page Posts) ──────────────────────────────────────
# Get from: https://developers.facebook.com/apps
# Generate a Page Access Token via Graph API Explorer
# Permissions needed: pages_manage_posts, pages_read_engagement
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ── Instagram (Business via Graph API) ────────────────────────
# Requires: Instagram Business Account linked to a Facebook Page
# Same app as Facebook above; get IG Account ID from Graph Explorer
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ── WhatsApp Business API ─────────────────────────────────────
# Get from: https://developers.facebook.com/apps (same Meta app)
# Needs: WhatsApp Business Account + approved message template
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_PHONE=   # E.164 format: +919701314138

# ── Security ──────────────────────────────────────────────────
# Random secret to protect your API endpoints
API_SECRET=change_me_to_a_random_64_char_string
