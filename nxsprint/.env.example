# Copy to .env (`make env` does this and generates secrets). Never commit .env.
NXSPRINT_MODE=dry_run
# Shared bearer secret, min 16 chars. n8n sends it. `make env` generates one.
NXSPRINT_API_SECRET=
NXSPRINT_CONFIG_PATH=../config/projects.yaml
NXSPRINT_DATABASE_URL=sqlite:///./nxsprint.db

# Compose only
POSTGRES_USER=nxsprint
POSTGRES_PASSWORD=
POSTGRES_DB=nxsprint

# Used from Phase 3
NXSPRINT_MODEL=
NXSPRINT_MAX_DAILY_USD=

# Phase 1: GitHub (fine-grained token, read access to project and issues)
NXSPRINT_GITHUB_TOKEN=
NXSPRINT_GITHUB_WEBHOOK_SECRET=
