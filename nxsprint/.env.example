# Copy to .env (`make env` does this and generates secrets). Never commit .env.
NXSPRINT_MODE=dry_run
# Shared bearer secret, min 16 chars. n8n sends it. `make env` generates one.
NXSPRINT_API_SECRET=
NXSPRINT_CONFIG_PATH=../config/projects.yaml
NXSPRINT_DATABASE_URL=sqlite:///./nxsprint.db

# Compose only
POSTGRES_USER=nxsprint
POSTGRES_PASSWORD=
POSTGRES_DB=nxsprint

# Phase 3: Claude wording. Leave NXSPRINT_MODEL blank to use plain templates only.
# If NXSPRINT_MODEL is set, the next three are required. Prices are USD per million tokens
# for that model; get them from Anthropic's pricing page. Auth is ANTHROPIC_API_KEY.
NXSPRINT_MODEL=
NXSPRINT_MAX_DAILY_USD=
NXSPRINT_PRICE_INPUT_PER_MTOK=
NXSPRINT_PRICE_OUTPUT_PER_MTOK=
ANTHROPIC_API_KEY=

# Phase 1: GitHub (fine-grained token, read access to project and issues)
NXSPRINT_GITHUB_TOKEN=
NXSPRINT_GITHUB_WEBHOOK_SECRET=

# Phase 4: Teams delivery (only used when NXSPRINT_MODE=live).
# The config's channels.dm_webhook_env names the variable holding the Power Automate
# "Workflows" webhook URL. It is a secret, it lives only here, and it must be https.
# TEAMS_WEBHOOK_DEMO_DM=
# While set, live mode sends every message to this target instead of the real person.
# Use it for the first live run, remove it only when you are happy with what you saw.
NXSPRINT_DELIVERY_REDIRECT_TARGET=

# Phase 5: Teams two way (Azure Bot registration, see docs/teams-setup.md). All three or none.
NXSPRINT_BOT_APP_ID=
NXSPRINT_BOT_APP_PASSWORD=
NXSPRINT_BOT_TENANT_ID=

# Phase 7: WhatsApp escalation for critical items only. OFF by default. When true, all four are required
# and every project needs a whatsapp block in config plus a lead with whatsapp_number (docs/whatsapp.md).
NXSPRINT_WHATSAPP_ENABLED=false
NXSPRINT_WHATSAPP_TOKEN=
NXSPRINT_WHATSAPP_PHONE_NUMBER_ID=
NXSPRINT_WHATSAPP_API_VERSION=
