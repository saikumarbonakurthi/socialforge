{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "REPLACE_WITH_APP_ID",
  "developer": {
    "name": "SRIA Infotech",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": { "short": "NxSprint", "full": "NxSprint scrum assistant" },
  "description": {
    "short": "Scrum assistant for SRIA projects",
    "full": "Sends standup prompts and nudges, and lets you acknowledge them by replying."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#2F5D8A",
  "bots": [
    {
      "botId": "REPLACE_WITH_APP_ID",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
